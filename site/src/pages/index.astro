---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import AdjacencyMatrix from "../components/AdjacencyMatrix";
import WeekGrid, { type WeekCard } from "../components/WeekGrid";
import Magnet from "../components/bits/Magnet";
import { site } from "../site.config";
import { url, fmtDate } from "../lib/url";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort((a, b) => b.data.week - a.data.week);
const latest = posts[0];
const byWeek = new Map(posts.map((p) => [p.data.week, p]));
const plus = (iso: string, days: number) => { const d = new Date(iso); d.setDate(d.getDate() + days); return d; };

const cards: WeekCard[] = site.schedule.map((s) => {
  const p = byWeek.get(s.week);
  return p
    ? { week: s.week, topic: s.topic, date: fmtDate(p.data.date), unlock: "", locked: false,
        href: url(`/posts/${p.id}/`), title: p.data.title, description: p.data.description }
    : { week: s.week, topic: s.topic, date: fmtDate(s.date), unlock: fmtDate(plus(s.date, 5)), locked: true };
});
cards.push({ week: "9–13", topic: "Final project", date: "Nov–Dec", unlock: "2 Dec · demo fair", locked: true });
const latestCta = latest?.data.week === 3
  ? { anchor: "#clique-lab", label: "Explore the six cliques" }
  : latest?.data.week === 1
    ? { anchor: "#play", label: "Play: two clicks from Spider-Man" }
    : { anchor: "", label: "Explore this week" };
---
<Base>
  <!-- hero: la matriz de la semana actual + el post más reciente -->
  <section class="grid lg:grid-cols-[minmax(0,520px)_1fr] gap-10 lg:gap-16 items-start pt-8 pb-16">
    <div>
      <div class="panel p-2">
        <AdjacencyMatrix client:only="react" week={latest?.data.week ?? 1} />
      </div>
      <p class="font-mono text-[0.72rem] text-ink-muted mt-2 leading-snug">
        Adjacency matrix, week {latest?.data.week ?? 1} · nodes sorted by degree · row{" "}
        <span style="color:var(--color-out)">links out</span>, column{" "}
        <span style="color:var(--color-in)">links in</span> · hover
      </p>
    </div>

    <div class="lg:pt-4">
      <p class="font-mono text-[0.75rem] uppercase tracking-wider text-ink-muted">{site.course.code} · {site.course.name}</p>
      <h1 class="font-display font-extrabold text-[2.6rem] sm:text-[3.4rem] leading-[0.98] tracking-[-0.02em] mt-3">{site.group}</h1>
      <p class="mt-5 text-[1.15rem] max-w-[34ch] text-ink-muted">{site.tagline}</p>
      <p class="font-mono text-[0.75rem] text-ink-muted mt-3">{site.members.join(" · ")}</p>

      {latest && (
        <div class="mt-10 border-t-2 border-ink pt-4">
          <p class="font-mono text-[0.72rem] text-ink-muted">Latest · Week {latest.data.week} · {latest.data.topic} · {fmtDate(latest.data.date)}</p>
          <a href={url(`/posts/${latest.id}/`)} class="block mt-2 font-display font-bold text-2xl leading-tight tracking-tight hover:text-in transition-colors">{latest.data.title}</a>
          <p class="mt-2 text-ink-muted max-w-[40ch]">{latest.data.description}</p>
          <div class="flex flex-wrap items-center gap-4 mt-5">
            <Magnet client:visible padding={40} magnetStrength={4}>
              <a href={url(`/posts/${latest.id}/${latestCta.anchor}`)} class="inline-block px-4 py-2 rounded font-mono text-[0.78rem] bg-ink text-white hover:bg-in transition-colors no-underline">{latestCta.label}</a>
            </Magnet>
            <a href={url(`/posts/${latest.id}/`)} class="font-mono text-[0.78rem] underline underline-offset-4 hover:text-in">Read the post →</a>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- selector de semanas: la secuencia real del curso -->
  <section id="posts" class="pb-10">
    <div class="flex items-baseline justify-between border-b-2 border-ink pb-2 mb-5">
      <h2 class="font-display font-bold text-xl tracking-tight">Weeks</h2>
      <p class="font-mono text-[0.72rem] text-ink-muted">one post per week · unlocked as we go</p>
    </div>
    <WeekGrid client:visible cards={cards} />
  </section>
</Base>
