---
// Fila de números clave. items: [{ value, label, tone?: "in" | "out" }]
interface Props { items: { value: string | number; label: string; tone?: "in" | "out" }[] }
const { items } = Astro.props;
---
<dl class="my-8 grid grid-cols-2 sm:grid-cols-4 gap-x-6 gap-y-5 font-mono">
  {items.map((it) => (
    <div class="border-t-2 pt-2" class:list={[it.tone === "in" ? "border-in" : it.tone === "out" ? "border-out" : "border-ink"]}>
      <dd class="font-display font-bold text-2xl tracking-tight leading-none">{it.value}</dd>
      <dt class="text-[0.72rem] text-ink-muted mt-1.5 leading-snug">{it.label}</dt>
    </div>
  ))}
</dl>
